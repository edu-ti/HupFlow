# -----------------------------------------------------------------------------
# HupFlow Clean-Room Environment Variables Template
# -----------------------------------------------------------------------------

# Application
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://hupflow:hupflow_secret@localhost:5432/hupflow_db

# Cache & Queues (Redis 7)
REDIS_URL=redis://localhost:6379

# Authentication (Better-Auth)
BETTER_AUTH_SECRET=hupflow_super_secret_jwt_key_2026_enterprise
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 / AWS S3 / MinIO Local Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=hupflow_minio_admin
STORAGE_SECRET_KEY=hupflow_minio_secret_key_2026
STORAGE_BUCKET=hupflow-media
STORAGE_PUBLIC_URL=http://localhost:9000/hupflow-media

# Stripe Billing (Sandbox / Production)
STRIPE_SECRET_KEY=sk_test_hupflow_demo_sandbox_key
STRIPE_WEBHOOK_SECRET=whsec_hupflow_demo_webhook_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_hupflow_demo_key
