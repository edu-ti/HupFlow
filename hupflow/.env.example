# ==============================================================================
# HUPFLOW - VARIÁVEIS DE AMBIENTE
# Clean Architecture & Anti-AGPL Software Engineering
# ==============================================================================

# 1. Banco de Dados PostgreSQL & Drizzle ORM
DATABASE_URL="postgres://postgres:postgres@localhost:5432/hupflow"

# 2. Redis para Filas BullMQ (Delayed Jobs & Backoff)
REDIS_URL="redis://127.0.0.1:6379"

# 3. Chave de Criptografia AES-256-GCM para Tokens de Redes Sociais (32 caracteres)
ENCRYPTION_KEY="hupflow-super-secret-dev-encryption-key-32b!"

# 4. Better-Auth (Autenticação Multi-Tenant & Organizações)
BETTER_AUTH_SECRET="hupflow-better-auth-secret-key-super-secure"
BETTER_AUTH_URL="http://localhost:3000"

# 5. Vercel AI SDK & Provedores de IA (OpenAI / Anthropic / Groq)
OPENAI_API_KEY=""

# 6. Conectores Sociais (OAuth 2.0 PKCE)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

X_CLIENT_ID=""
X_CLIENT_SECRET=""

# 7. Conectores Meta (Instagram Graph API & Threads API)
META_APP_ID=""
META_APP_SECRET=""

THREADS_APP_ID=""
THREADS_APP_SECRET=""

